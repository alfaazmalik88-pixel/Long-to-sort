# Server Environment Configuration
PORT=3000

# Google Gemini AI Transcription & Subtitle Intelligence (Gemini 1.5 Flash)
GEMINI_API_KEY=your_gemini_api_key

# Razorpay Payments Configuration (India - INR)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Polar.sh Payments Configuration (Global - USD Merchant of Record)
# Get your token from https://polar.sh/settings
POLAR_ACCESS_TOKEN=your_polar_access_token
POLAR_ORGANIZATION_ID=your_polar_organization_id
# Optional: Specific Polar.sh Product IDs for plans
POLAR_PRODUCT_STARTER=
POLAR_PRODUCT_CREATOR=
POLAR_PRODUCT_PRO=
POLAR_PRODUCT_AGENCY=
