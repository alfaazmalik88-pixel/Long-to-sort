# Server Environment Configuration
PORT=3000

# Google Gemini AI Transcription & Subtitle Intelligence (Gemini 1.5 Flash)
GEMINI_API_KEY=your_gemini_api_key

# Razorpay Payments Configuration (India - INR)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Whop Payments Configuration (Global - USD whop.com)
# Get your API key / checkout links from https://whop.com/dashboard
WHOP_API_KEY=your_whop_api_key
WHOP_COMPANY_ID=your_whop_company_id
WHOP_CHECKOUT_URL=https://whop.com/checkout/
# Optional: Specific Whop Plan IDs / Links for each tier
WHOP_PLAN_STARTER=
WHOP_PLAN_CREATOR=
WHOP_PLAN_PRO=
WHOP_PLAN_AGENCY=
